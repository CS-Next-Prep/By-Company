# ─── CS-Next ByCompany — root .gitignore ──────────────────────────────────

# ── Personal / internal files — never commit ──────────────────────────────
Logo.png
AGENTS.md
SKILL.md


#  1. Secrets / credentials — never commit these
#  2. Large generated data — fetched/built at CI time, not stored in git
#  3. Build artifacts & caches — reproducible, not version-controlled
#  4. IDE / OS noise — local editor files
#  5. Node / package manager
#  6. Next.js specifics

# ── 1. Secrets & credentials ──────────────────────────────────────────────
# Environment files can hold API keys, tokens, DB passwords, etc.
.env
.env.*
!.env.example          # allow a template with no real values

# Any file that looks like a key or token
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# ── 2. Large generated / fetched data ─────────────────────────────────────
# companies-index.json (57 KB)   — committed: drives home page at build time
# companies.json      (4.6 MB)   — committed: required by generateStaticParams
# questions-index.json (2 MB)    — committed: required by ProblemPanel search
#
# All three are static build assets with no secrets — they live in git so
# Vercel's build server has them without needing a pre-build ingest step.
#
# Logos are fetched at ingest time and committed for the same reason.
# If the folder grows too large, uncomment the line below and add a
# logo-fetch step to the CI workflow before building.
# site/public/logos/


# ── 3. Build artifacts & Next.js cache ────────────────────────────────────
site/.next/
site/out/
site/.turbo/
site/coverage/
*.tsbuildinfo
next-env.d.ts
site/next-env.d.ts

# ── 4. Node / package managers ────────────────────────────────────────────
node_modules/
site/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# ── 5. OS & editor noise ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.vscode/settings.json   # keep .vscode/extensions.json if you want it
.idea/
*.sublime-workspace

# ── 6. Miscellaneous ──────────────────────────────────────────────────────
.vercel
.netlify
dist/
build/

# ── What IS committed ─────────────────────────────────────────────────────
# ✅ scripts/ingest.mjs          — data pipeline (re-runnable)
# ✅ site/public/data/companies-index.json — slim company list (57 KB)
# ✅ site/public/logos/          — cached logos (binary, but needed for build)
# ✅ site/public/Logo.png        — club logo asset
# ✅ site/app/, site/components/ — all source code
# ✅ site/package.json, site/package-lock.json — locked deps
# ✅ AGENTS.md, README.md, LICENSE — project meta
